# ============================================================
# UI acceptance tests — environment configuration
# ============================================================
#
# Setup:
#   cp env/env.acceptance-ui.template env/.env.acceptance-ui
#   # fill cluster + operator fields below
#
# Run:
#   ENV_FILE=env/.env.acceptance-ui ./scripts/run-ui-workflow.sh
#   # or submit PipelineRun only:
#   ENV_FILE=env/.env.acceptance-ui ./scripts/hack/create-pipelinerun-ui.sh
# ============================================================

# --- Cluster connection ---
# APISERVER = management cluster (where pipelines-ci / Tekton runs). Required for all INSTALLER values.
# INSTALLER=none  (test cluster must exist; APISERVER + KUBEADMIN_PASSWORD)
# INSTALLER=cluster-platforms  (required: APISERVER, OC_TOKEN)
# INSTALLER=aws-ipi  (pipeline provisions test cluster; set AWS creds + PULL_SECRET below)
# INSTALLER=aro  (pipeline provisions test cluster on Azure)
CLUSTER_NAME=
APISERVER=
KUBEADMIN_PASSWORD=
KUBEADMIN_USER=kubeadmin
USER_PASSWORD=user
# OC_TOKEN=
# CLUSTER_CA_CERT=

# --- Provisioning (aws-ipi / aro) ---
INSTALLER=none
BASE_DOMAIN=aws.ospqa.com
AWS_REGION=us-east-2
AZURE_LOCATION=eastus
OPENSHIFT_VERSION=stable
KEEP_CLUSTER=false
CLUSTER_LIFETIME=6h
# PULL_SECRET=              # JSON pull secret (required for INSTALLER=aws-ipi)
# SSH_PUBLIC_KEY=            # SSH public key for aws-ipi node access

# --- Operator (CHANNEL / GIT_RELEASE_TESTS_BRANCH auto-resolved from ci-config.yaml) ---
ARCH=linux/amd64
OPERATOR_VERSION=
OPERATOR_ENVIRONMENT=pre-stage
CATALOG_SOURCE=custom-operators
CHANNEL=
KONFLUX_INDEX_IMAGE=
INSTALL_PIPELINES_OPERATOR=true
INSTALL_LOGGING_OPERATOR=false
INSTALL_SERVERLESS_OPERATOR=false
UNINSTALL_PIPELINES_OPERATOR=false
SETUP_TESTING_ACCOUNTS=false

# --- Secret credential source (Vault)---
# VAULT_TOKEN=
# VAULT_ADDR=
# VAULT_KV_MOUNT=
# VAULT_KV_PATH=

# --- Secret credential source (local) ---
# local = non-empty vars below | vault = OIDC login + Vault KV (./scripts/create-secrets.sh --vault-login)
CRED_SOURCE=vault

# --- UI tests (GIT_UI_TESTS_BRANCH auto-resolved from ci-config.yaml by OCP version) ---
TEST_FRAMEWORK=gauge
GIT_RELEASE_TESTS_BRANCH=
GIT_RELEASE_TESTS_GINKGO_BRANCH=
GIT_UI_TESTS_URI=https://github.com/openshift-pipelines/release-ui-tests.git
GIT_UI_TESTS_BRANCH=
MARKERS=sanity
PYTEST_ARGS=
APP_TIMEOUT=90000
CAPTURE_SCREENSHOTS=true
# Record during pytest when true; Tekton uploads .webm to GCS only if tests fail
CAPTURE_RECORDINGS=true
IMAGE=quay.io/openshift-pipeline/ci:latest
UI_IMAGE=quay.io/openshift-pipeline/ui-ci:latest
TKN_DOWNLOAD_URL=

# --- Git ---
GIT_INFRA_BRANCH=main

# --- Post-test ---
SEND_SLACK_NOTIFICATION=false

# --- AWS (required when INSTALLER=aws-ipi — used by create-secrets.sh) ---
# AWS_ACCESS_KEY=
# AWS_ACCESS_SECRET=

# ============================================================
# PROFILE: Pre-stage UI sanity (unreleased operator + pytest -m sanity)
# Uncomment to override values above.
# ============================================================
# OPERATOR_ENVIRONMENT=pre-stage
# CATALOG_SOURCE=custom-operators
# KONFLUX_INDEX_IMAGE=quay.io/openshift-pipeline/pipelines-index-4.20:v1.23.0
# INSTALL_PIPELINES_OPERATOR=true
# MARKERS=sanity
# SETUP_TESTING_ACCOUNTS=false

# ============================================================
# PROFILE: Prod UI sanity (released operator from redhat-operators)
# ============================================================
# OPERATOR_ENVIRONMENT=prod
# CATALOG_SOURCE=redhat-operators
# KONFLUX_INDEX_IMAGE=
# INSTALL_PIPELINES_OPERATOR=true
# MARKERS=sanity
