# ============================================================
# UI acceptance tests — environment configuration
# ============================================================
#
# Setup:
#   cp env/env.acceptance-ui.template env/.env.acceptance-ui
#   # fill cluster + operator fields below
#
# Run:
#   ENV_FILE=env/.env.acceptance-ui ./scripts/run-ui-workflow.sh
#   # or submit PipelineRun only:
#   ENV_FILE=env/.env.acceptance-ui ./scripts/hack/create-pipelinerun-ui.sh
#
# OSP / logging / serverless install is handled by infra (setup-pipelines-ci +
# run-ui-workflow). The PipelineRun always sends INSTALL_PIPELINES_OPERATOR=false
# to release-ui-tests for now (framework product-install path deferred).
# INSTALL_LOGGING_OPERATOR / INSTALL_SERVERLESS_OPERATOR are still passed through.
# ============================================================

# --- Cluster connection ---
# API_URL = management cluster (where pipelines-ci / Tekton runs). Required for all INSTALLER values.
# INSTALLER=none  (test cluster must exist; API_URL + CONSOLE_PASSWORD)
# INSTALLER=cluster-platforms  (required: API_URL, OC_TOKEN)
# INSTALLER=aws-ipi  (pipeline provisions test cluster; set AWS creds + PULL_SECRET below)
# INSTALLER=aro  (pipeline provisions test cluster on Azure)
#
# UI framework credentials (required for INSTALLER=none / existing cluster):
#   API_URL, CONSOLE_URL, CONSOLE_USERNAME, CONSOLE_PASSWORD
CLUSTER_NAME=
API_URL=
CONSOLE_URL=
CONSOLE_USERNAME=kubeadmin
CONSOLE_PASSWORD=
USER_PASSWORD=user
# OC_TOKEN=
# CLUSTER_CA_CERT=

# --- Provisioning (aws-ipi / aro) ---
INSTALLER=none
BASE_DOMAIN=aws.ospqa.com
AWS_REGION=us-east-2
AZURE_LOCATION=eastus
OPENSHIFT_VERSION=stable
KEEP_CLUSTER=false
CLUSTER_LIFETIME=6h
# PULL_SECRET='{"auths":...}'  # MUST be single-quoted JSON (required for INSTALLER=aws-ipi)
# SSH_PUBLIC_KEY=            # SSH public key for aws-ipi node access

# --- Operator (CHANNEL auto-resolved from ci-config.yaml; installed by infra) ---
ARCH=linux/amd64
OPERATOR_VERSION=
OPERATOR_ENVIRONMENT=pre-stage
# Still used by local validate_operator_env (prod→redhat-operators, else custom-operators)
CATALOG_SOURCE=custom-operators
CHANNEL=
KONFLUX_INDEX_IMAGE=
# true → setup-pipelines-ci installs OSP (needed for Tekton CRDs on INSTALLER=none)
INSTALL_PIPELINES_OPERATOR=true
# Passed to framework for future use; PipelineRun forces INSTALL_PIPELINES_OPERATOR=false
OSP_INSTALL_METHOD=ui
INSTALL_LOGGING_OPERATOR=false
INSTALL_SERVERLESS_OPERATOR=false

# --- Secret credential source (Vault)---
# VAULT_TOKEN=
# VAULT_ADDR=
# VAULT_KV_MOUNT=
# VAULT_KV_PATH=

# --- Secret credential source (local) ---
# local = non-empty vars below | vault = OIDC login + Vault KV (./scripts/create-secrets.sh --vault-login)
CRED_SOURCE=vault

# --- UI tests (GIT_UI_TESTS_BRANCH auto-resolved from ci-config.yaml by OCP version) ---
GIT_UI_TESTS_URI=https://github.com/openshift-pipelines/release-ui-tests.git
GIT_UI_TESTS_BRANCH=
MARKERS=sanity
PYTEST_ARGS=
APP_TIMEOUT=90000
AUTH_TYPE=kube:admin
CAPTURE_SCREENSHOTS=true
# Record during pytest when true (Playwright .webm under ARTIFACTS_DIR/recordings/)
CAPTURE_RECORDINGS=true
# Upload .webm to GCS only when tests fail (requires CAPTURE_RECORDINGS=true; default off)
UPLOAD_RECORDINGS_ON_FAILURE=false
UI_IMAGE=quay.io/openshift-pipeline/ui-ci:latest

# --- Git ---
GIT_INFRA_BRANCH=main

# --- Post-test ---
SEND_SLACK_NOTIFICATION=false

# --- AWS (required when INSTALLER=aws-ipi — used by create-secrets.sh) ---
# AWS_ACCESS_KEY=
# AWS_ACCESS_SECRET=

# ============================================================
# PROFILE: Pre-stage UI sanity (unreleased operator + pytest -m sanity)
# Uncomment to override values above.
# ============================================================
# OPERATOR_ENVIRONMENT=pre-stage
# CATALOG_SOURCE=custom-operators
# KONFLUX_INDEX_IMAGE=quay.io/openshift-pipeline/pipelines-index-4.20:v1.23.0
# INSTALL_PIPELINES_OPERATOR=true
# OSP_INSTALL_METHOD=ui
# INSTALL_LOGGING_OPERATOR=false
# INSTALL_SERVERLESS_OPERATOR=false
# MARKERS=sanity

# ============================================================
# PROFILE: Prod UI sanity (released operator from redhat-operators)
# ============================================================
# OPERATOR_ENVIRONMENT=prod
# CATALOG_SOURCE=redhat-operators
# KONFLUX_INDEX_IMAGE=
# INSTALL_PIPELINES_OPERATOR=true
# OSP_INSTALL_METHOD=ui
# MARKERS=sanity
